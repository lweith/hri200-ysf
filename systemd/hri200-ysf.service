[Unit]
Description=HRI-200 to YSF gateway (read-only USB sniffer)
Documentation=https://github.com/lweith/hri200-ysf
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
# Root only to open /dev/usbmonN, which is mode 0600; nothing is written to the
# HRI-200, and the sandbox below allows reading usbmon and sysfs, no more.
ExecStart=/usr/local/bin/hri200-ysf -cache /var/lib/hri200-ysf/cache.json -overs /var/lib/hri200-ysf/overs -keep 7
Restart=always
RestartSec=5
# The cache of the HRI-200's replies, for hri200-ysf-proxy.service, and a week
# of transmissions (up to about 200 MB a day if the room never goes quiet).
StateDirectory=hri200-ysf
StateDirectoryMode=0700

DevicePolicy=closed
DeviceAllow=char-usbmon r
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
