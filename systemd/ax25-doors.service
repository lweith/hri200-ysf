[Unit]
Description=Game doors over AX.25: wumpus KN6FLN-11, trek KN6FLN-12 (ax25-door on direwolf-hri200's AGW port)
After=direwolf-hri200.service
Wants=direwolf-hri200.service

[Service]
# One process for all doors: direwolf 1.7 takes only three AGW clients, and
# the proxy's session tracker and airtime are two of them.
ExecStart=/usr/local/bin/ax25-door -agw 127.0.0.1:8000 \
	-door "KN6FLN-11 /usr/games/wump" \
	-banner "KN6FLN-11 W8HHF/R wumpus door. Answer n to skip the instructions (2 kB, about 20 s on the air). ^D or Q to leave." \
	-door "KN6FLN-12 /usr/games/trek" \
	-banner "KN6FLN-12 W8HHF/R trek door. Send return, then short, novice and any password. ? lists commands (srscan, lrscan, move, phasers, torpedo, dock...); terminate or ^D to leave."
Restart=always
RestartSec=10
DynamicUser=yes
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# /dev/ptmx and a private devpts for the games' ptys.
PrivateDevices=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
