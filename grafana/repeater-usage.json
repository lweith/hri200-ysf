      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source, mode) (increase(hri200_keyed_seconds_total{job=\"hri200\"}[$__range]))",
          "legendFormat": "{{source}} {{mode}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
